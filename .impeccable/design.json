  "narrative": {
    "northStar": "The Signal Booth",
    "overview": "A broadcast control room after hours, written up by a good magazine. The page is ink-dark and warm; a single ember accent marks what is live and what to press, and a teal signal light confirms that things are working. Serif headlines carry editorial authority and trust; small mono readouts carry the technical precision of a capture in progress. Atmosphere comes from the room itself (a faint ember wash in the corners, fine scanlines over everything), never from glowing components.\n\nDensity is calm: one idea per section, generous vertical rhythm, hairlines doing the structural work. Components are refined and restrained: flat surfaces, hairline borders, the accent reserved for the one primary action and for live data.",
    "keyCharacteristics": [
      "Dark, warm ink ground with ember as the only saturated hue; teal appears only as a \"live / OK\" signal.",
      "Fraunces display with an italic ember accent word in each headline; Figtree body; JetBrains Mono for readouts and labels only.",
      "Hairline ledgers instead of card grids.",
      "The booth panel (a schematic of the popup mid-download) is the signature object.",
      "No glows, no gradient text, no eyebrow labels above headings."
    ],
    "rules": [
      {
        "name": "The One Ember Rule",
        "body": "Ember fills exactly one kind of thing per view: the primary action, or live capture data. Everything else is ink, bone, or hairline.",
        "section": "colors"
      },
      {
        "name": "The Signal Is Status Rule",
        "body": "Teal means \"working / found / OK\". Never use it for decoration or emphasis.",
        "section": "colors"
      },
      {
        "name": "The No Kicker Rule",
        "body": "Headings stand alone. No eyebrow, section number, or mono label above a heading.",
        "section": "typography"
      },
      {
        "name": "The Mono Means Measurement Rule",
        "body": "Mono only for code, data, and readouts, never as \"technical\" costume on prose.",
        "section": "typography"
      },
      {
        "name": "The No Halo Rule",
        "body": "No zero-offset or colored glow on any element. Atmosphere belongs to the page background (ember wash, scanlines), not to components.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep Ember (#ff6a1a) to the primary action and live capture data (The One Ember Rule).",
      "Do use hairline ledgers (1px, 16% Bone) to structure feature lists instead of boxed cards.",
      "Do give each headline exactly one italic Ember Light accent word or phrase.",
      "Do keep text at Bone Faint (#8a8072) or brighter on Ink.",
      "Do theme browser surfaces: Ember selection, ink scrollbars, Ember Light focus outlines."
    ],
    "donts": [
      "Don't add glows or colored shadows to buttons, logos, dots, or avatars (The No Halo Rule).",
      "Don't use gradient text; the accent word is a solid color.",
      "Don't put kickers, eyebrows, or section numbers above headings (The No Kicker Rule).",
      "Don't add pulsing or looping decoration; the booth meter is the one authored motion.",
      "Don't style the booth as a literal screenshot of the popup, whose real palette differs."
    ]
  }
